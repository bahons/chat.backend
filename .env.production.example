# Copy to .env.production; chmod 600. Never commit populated values.
API_DOMAIN=chat.dodapp.kz
WEB_ORIGIN=https://app.example.com
APP_TAG=local
# Generate with: openssl rand -hex 32 (hex avoids connection-string delimiters).
POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
# Generate two independent values with: openssl rand -base64 32
JWT_SIGNING_KEY_BASE64=
MAIL_QUEUE_KEY_BASE64=
JWT_ISSUER=chat-production
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# Existing private bucket; endpoint must also be reachable by web/mobile clients.
S3_URL=
S3_REGION=us-east-1
S3_BUCKET=chat-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Reachable clamd in a trusted private network; never expose it publicly.
CLAMAV_HOST=
CLAMAV_PORT=3310
PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
RETENTION_APPROVED=false
RETENTION_LEGAL_HOLD=false
DOCKER_SUBNET=10.253.84.0/24
DOCKER_GATEWAY=10.253.84.1
API_PORT=15105
