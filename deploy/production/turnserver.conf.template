# Render on the server into private/turn/turnserver.conf, mode 0400 uid 65534.
listening-port=3478
tls-listening-port=5349
listening-ip=0.0.0.0
relay-ip=@PUBLIC_IPV4@
external-ip=@PUBLIC_IPV4@
min-port=49160
max-port=49259
realm=@API_DOMAIN@
server-name=@API_DOMAIN@
fingerprint
use-auth-secret
static-auth-secret=@TURN_SHARED_SECRET@
cert=/run/coturn-tls/fullchain.pem
pkey=/run/coturn-tls/privkey.pem
userdb=/tmp/turndb
pidfile=/tmp/turnserver.pid
log-file=stdout
simple-log
relay-threads=2
no-multicast-peers
no-tcp-relay
# Coturn 4.19 defaults: CLI off, DTLS off, TLS minimum 1.2. Do not enable legacy protocols.
user-quota=8
total-quota=200
max-allocate-lifetime=300
max-bps=1250000
bps-capacity=12500000
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=224.0.0.0-255.255.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
